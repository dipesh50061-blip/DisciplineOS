import sqlite3
import random
import time
from datetime import datetime, date
from collections import defaultdict

# =========================================================
# DATABASE SYSTEM
# =========================================================

class DatabaseManager:

    def __init__(self):

        self.conn = sqlite3.connect("discipline_os.db")

        self.cursor = self.conn.cursor()

        self.create_tables()

    # =====================================================

    def create_tables(self):

        self.cursor.execute("""

        CREATE TABLE IF NOT EXISTS users (

            username TEXT PRIMARY KEY,
            password TEXT,
            level INTEGER,
            xp INTEGER,
            streak INTEGER,
            total_hours REAL
        )

        """)

        self.cursor.execute("""

        CREATE TABLE IF NOT EXISTS study_sessions (

            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT,
            subject TEXT,
            duration REAL,
            focus INTEGER,
            session_time TEXT
        )

        """)

        self.cursor.execute("""

        CREATE TABLE IF NOT EXISTS subjects (

            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT,
            subject TEXT,
            priority INTEGER,
            weak_topics TEXT
        )

        """)

        self.cursor.execute("""

        CREATE TABLE IF NOT EXISTS moods (

            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT,
            mood TEXT,
            mood_date TEXT
        )

        """)

        self.conn.commit()

# =========================================================
# USER SYSTEM
# =========================================================

class User:

    def __init__(self, db):

        self.db = db

        self.username = None

    # =====================================================

    def signup(self):

        print("\n========== SIGN UP ==========")

        username = input("Create username: ")

        password = input("Create password: ")

        try:

            self.db.cursor.execute("""

            INSERT INTO users
            VALUES (?, ?, ?, ?, ?, ?)

            """, (

                username,
                password,
                1,
                0,
                0,
                0
            ))

            self.db.conn.commit()

            print("\n✅ Account Created Successfully!")

        except:

            print("\n❌ Username already exists.")

    # =====================================================

    def login(self):

        print("\n========== LOGIN ==========")

        username = input("Enter username: ")

        password = input("Enter password: ")

        self.db.cursor.execute("""

        SELECT * FROM users
        WHERE username=? AND password=?

        """, (username, password))

        result = self.db.cursor.fetchone()

        if result:

            self.username = username

            print(f"\n🔥 Welcome back, {username}")

            return True

        else:

            print("\n❌ Invalid credentials.")

            return False

    # =====================================================

    def get_stats(self):

        self.db.cursor.execute("""

        SELECT level, xp, streak, total_hours
        FROM users
        WHERE username=?

        """, (self.username,))

        return self.db.cursor.fetchone()

# =========================================================
# AI ENGINE
# =========================================================

class AIEngine:

    def __init__(self, db, user):

        self.db = db

        self.user = user

    # =====================================================

    def add_subject(self):

        print("\n========== ADD SUBJECT ==========")

        subject = input("Enter subject: ")

        priority = int(
            input("Enter priority (1-10): ")
        )

        weak_topics = input(
            "Enter weak topics (comma separated): "
        )

        self.db.cursor.execute("""

        INSERT INTO subjects
        (username, subject, priority, weak_topics)

        VALUES (?, ?, ?, ?)

        """, (

            self.user.username,
            subject,
            priority,
            weak_topics
        ))

        self.db.conn.commit()

        print("\n✅ Subject Added!")

    # =====================================================

    def show_subjects(self):

        self.db.cursor.execute("""

        SELECT subject, priority, weak_topics
        FROM subjects
        WHERE username=?

        """, (self.user.username,))

        subjects = self.db.cursor.fetchall()

        print("\n========== SUBJECTS ==========")

        for subject in subjects:

            print(f"\n📚 {subject[0]}")

            print(f"⭐ Priority: {subject[1]}")

            print(f"⚠️ Weak Topics: {subject[2]}")

    # =====================================================

    def generate_ai_goals(self):

        self.db.cursor.execute("""

        SELECT subject, priority, weak_topics
        FROM subjects
        WHERE username=?

        """, (self.user.username,))

        subjects = self.db.cursor.fetchall()

        if len(subjects) == 0:

            print("\n❌ Add subjects first.")

            return

        available_hours = float(
            input("\nEnter study hours today: ")
        )

        total_priority = sum(
            subject[1]
            for subject in subjects
        )

        print("\n========== AI STUDY PLAN ==========")

        for subject in subjects:

            subject_name = subject[0]

            priority = subject[1]

            weak_topics = subject[2].split(",")

            allocated_time = (

                priority
                / total_priority

            ) * available_hours

            selected_topic = random.choice(
                weak_topics
            )

            print(

                f"\n📚 Study {selected_topic.strip()}"
                f" in {subject_name}"

            )

            print(
                f"⏰ Time: "
                f"{round(allocated_time,1)} hrs"
            )

# =========================================================
# STUDY SESSION SYSTEM
# =========================================================

class StudySystem:

    def __init__(self, db, user):

        self.db = db

        self.user = user

    # =====================================================

    def add_session(self):

        print("\n========== ADD SESSION ==========")

        subject = input("Subject: ")

        duration = float(
            input("Duration (hours): ")
        )

        focus = int(
            input("Focus Level (1-10): ")
        )

        session_time = datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"
        )

        self.db.cursor.execute("""

        INSERT INTO study_sessions
        (username, subject, duration, focus, session_time)

        VALUES (?, ?, ?, ?, ?)

        """, (

            self.user.username,
            subject,
            duration,
            focus,
            session_time
        ))

        # XP SYSTEM
        xp_gained = int(duration * 50)

        if focus >= 8:
            xp_gained += 20

        # UPDATE USER STATS
        self.db.cursor.execute("""

        UPDATE users

        SET xp = xp + ?,
            total_hours = total_hours + ?

        WHERE username=?

        """, (

            xp_gained,
            duration,
            self.user.username
        ))

        self.db.conn.commit()

        print("\n✅ Session Added!")

        print(f"⚡ XP Gained: {xp_gained}")

# =========================================================
# ANALYTICS ENGINE
# =========================================================

class AnalyticsEngine:

    def __init__(self, db, user):

        self.db = db

        self.user = user

    # =====================================================

    def weekly_report(self):

        self.db.cursor.execute("""

        SELECT subject, duration, focus
        FROM study_sessions
        WHERE username=?

        """, (self.user.username,))

        sessions = self.db.cursor.fetchall()

        if len(sessions) == 0:

            print("\nNo data available.")
            return

        subject_hours = defaultdict(float)

        total_focus = 0

        for session in sessions:

            subject_hours[
                session[0]
            ] += session[1]

            total_focus += session[2]

        best_subject = max(
            subject_hours,
            key=subject_hours.get
        )

        weakest_subject = min(
            subject_hours,
            key=subject_hours.get
        )

        average_focus = (
            total_focus / len(sessions)
        )

        print("\n========== WEEKLY REPORT ==========")

        print(f"📚 Best Subject: {best_subject}")

        print(f"📉 Weakest Subject: {weakest_subject}")

        print(
            f"🧠 Average Focus: "
            f"{average_focus:.2f}"
        )

    # =====================================================

    def discipline_score(self):

        self.db.cursor.execute("""

        SELECT total_hours, streak
        FROM users
        WHERE username=?

        """, (self.user.username,))

        data = self.db.cursor.fetchone()

        total_hours = data[0]

        streak = data[1]

        self.db.cursor.execute("""

        SELECT AVG(focus)
        FROM study_sessions
        WHERE username=?

        """, (self.user.username,))

        avg_focus = self.db.cursor.fetchone()[0]

        if avg_focus is None:
            avg_focus = 0

        score = (

            total_hours * 10

            + avg_focus * 5

            + streak * 3
        )

        print("\n========== DISCIPLINE SCORE ==========")

        print(f"🔥 Score: {score:.2f}")

        if score >= 500:

            print("👑 Beast Mode")

        elif score >= 250:

            print("⚔️ Highly Disciplined")

        else:

            print("🌱 Keep Improving")

# =========================================================
# MOOD SYSTEM
# =========================================================

class MoodSystem:

    def __init__(self, db, user):

        self.db = db

        self.user = user

    # =====================================================

    def log_mood(self):

        print("\n========== MOOD TRACKER ==========")

        print("1. 😴 Tired")
        print("2. 😐 Normal")
        print("3. 🔥 Motivated")
        print("4. 😰 Stressed")

        choice = input("Enter mood: ")

        moods = {

            "1": "Tired",
            "2": "Normal",
            "3": "Motivated",
            "4": "Stressed"
        }

        mood = moods.get(choice, "Normal")

        self.db.cursor.execute("""

        INSERT INTO moods
        (username, mood, mood_date)

        VALUES (?, ?, ?)

        """, (

            self.user.username,
            mood,
            str(date.today())
        ))

        self.db.conn.commit()

        print(f"\n🧠 Mood Saved: {mood}")

# =========================================================
# POMODORO SYSTEM
# =========================================================

class PomodoroTimer:

    def start(self):

        print("\n========== POMODORO ==========")

        minutes = int(
            input("Enter study minutes: ")
        )

        print("\n📚 Focus Session Started...\n")

        for remaining in range(
            minutes * 60,
            0,
            -1
        ):

            mins = remaining // 60

            secs = remaining % 60

            print(
                f"{mins:02d}:{secs:02d}",
                end="\r"
            )

            time.sleep(1)

        print("\n\n✅ Session Complete!")

