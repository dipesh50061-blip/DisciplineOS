# =========================================================
# MAIN APP
# =========================================================

class DisciplineOS:

    def __init__(self):

        self.db = DatabaseManager()

        self.user = User(self.db)

    # =====================================================

    def start(self):

        while True:

            print("\n" + "=" * 60)
            print("         DISCIPLINE OS AI")
            print("=" * 60)

            print("1. Sign Up")
            print("2. Login")
            print("3. Exit")

            choice = input("\nEnter choice: ")

            if choice == "1":

                self.user.signup()

            elif choice == "2":

                if self.user.login():

                    self.dashboard()

            elif choice == "3":

                print("\n👋 Exiting App...")
                break

    # =====================================================

    def dashboard(self):

        ai_engine = AIEngine(
            self.db,
            self.user
        )

        study_system = StudySystem(
            self.db,
            self.user
        )

        analytics = AnalyticsEngine(
            self.db,
            self.user
        )

        mood_system = MoodSystem(
            self.db,
            self.user
        )

        timer = PomodoroTimer()

        coach = AICoach()

        while True:

            print("\n" + "=" * 60)
            print("            DASHBOARD")
            print("=" * 60)

            print("1. Add Subject")
            print("2. Show Subjects")
            print("3. Generate AI Goals")
            print("4. Add Study Session")
            print("5. Weekly Report")
            print("6. Discipline Score")
            print("7. Mood Tracker")
            print("8. Pomodoro Timer")
            print("9. AI Coach")
            print("10. Show Stats")
            print("11. Logout")

            choice = input("\nEnter choice: ")

            # =============================================

            if choice == "1":

                ai_engine.add_subject()

            elif choice == "2":

                ai_engine.show_subjects()

            elif choice == "3":

                ai_engine.generate_ai_goals()

            elif choice == "4":

                study_system.add_session()

            elif choice == "5":

                analytics.weekly_report()

            elif choice == "6":

                analytics.discipline_score()

            elif choice == "7":

                mood_system.log_mood()

            elif choice == "8":

                timer.start()

            elif choice == "9":

                coach.motivate()

            elif choice == "10":

                stats = self.user.get_stats()

                print("\n========== USER STATS ==========")

                print(f"🏆 Level: {stats[0]}")
                print(f"⚡ XP: {stats[1]}")
                print(f"🔥 Streak: {stats[2]}")
                print(f"📖 Total Hours: {stats[3]}")

            elif choice == "11":

                print("\n👋 Logged Out.")
                break

# =========================================================
# RUN APP
# =========================================================

app = DisciplineOS()

app.start()
